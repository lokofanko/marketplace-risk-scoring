# Local Docker Compose values. Do not reuse these credentials outside development.
POSTGRES_DB=marketplace_risk
POSTGRES_USER=risk_user
POSTGRES_PASSWORD=change_me_for_local_development

# Used when the ML service runs directly on the host with `make run`.
DATABASE_URL=postgresql://risk_user:change_me_for_local_development@localhost:5433/marketplace_risk

# Optional model serving configuration.
MODEL_VERSION=logreg_v1
APPROVE_THRESHOLD=0.3
BLOCK_THRESHOLD=0.75

# Backend scaffold placeholders.
DJANGO_SECRET_KEY=change_me_for_local_development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
